<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <!-- HEADER: Saat + Hava Durumu -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- SAAT -->
        <TextView
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:32"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000"/>

        <!-- BOŞLUK -->
        <View
            android:layout_width="16dp"
            android:layout_height="1dp"/>

        <!-- HAVA DURUMU -->
        <ImageView
            android:id="@+id/imgWeather"
            android:layout_width="24dp"
            android:layout_height="24dp"/>

        <TextView
            android:id="@+id/txtWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="--°C"
            android:textColor="#000"/>


        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="155dp"
            android:layout_height="36dp"
            android:contentDescription="Netelsan"
            android:scaleType="fitCenter"
            android:src="@drawable/netelsan_logo" />


        <ImageView
            android:id="@+id/btnLogs"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="#D32F2F" />


    </LinearLayout>
    <!-- MODE SWITCH -->
    <LinearLayout
        android:id="@+id/layoutModeSwitch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnRoomMode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
         android:text="Odaya Göre"
            android:textStyle="bold"
            android:background="#D32F2F"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/btnModuleMode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Modüle Göre"
            android:background="#EEEEEE"
            android:textColor="#757575"/>
    </LinearLayout>
    <!-- ODALAR (YATAY) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRooms"
        android:layout_width="0dp"
        android:layout_height="90dp"  android:paddingStart="12dp"
        android:paddingEnd="12dp"
       app:layout_constraintTop_toBottomOf="@id/layoutModeSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- MODÜLLER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvModules"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/rvRooms"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ODA EKLE -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/red_primary"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- MODULE MODE CONTAINER -->
    <LinearLayout
        android:id="@+id/moduleModeContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutModeSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModeModules"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:padding="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModuleRooms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
